# Awareness Be - Environment Variables
# Copy this file to .env.local and fill in your values

# Site URL
NEXT_PUBLIC_SITE_URL=https://awarenessbe.com

# Strapi 5 CMS Configuration
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_api_token_here

# DeepSeek AI API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# Cal.com Calendar Integration
NEXT_PUBLIC_CALCOM_URL=https://cal.com/your-username
CALCOM_API_KEY=your_calcom_api_key_here

# Resend Email API (for appointment confirmations)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=appointments@awarenessbe.com

# Cron Job Security
CRON_SECRET=your_random_cron_secret_here

# Optional: AWS S3 for Strapi Media (if using S3 storage)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=awareness-be-media